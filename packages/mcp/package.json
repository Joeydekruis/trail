{
  "name": "@trail/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trail Desktop MCP server (stdio + local HTTP). Legacy CLI MCP remains in @trail-pm/cli.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trail-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@trail/core": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}