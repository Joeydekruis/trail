{
  "name": "@trail/desktop",
  "version": "0.0.0",
  "private": true,
  "author": "Trail",
  "description": "Trail Desktop — Electron shell (see docs/superpowers/specs/2026-11-18-trail-desktop-briefing.md)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:analyze": "cross-env DESKTOP_ANALYZE=1 electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size-limit": "size-limit --config size-limit.config.js",
    "dist": "electron-builder --config electron-builder.yml",
    "dist:dir": "electron-builder --config electron-builder.yml --dir",
    "test": "node --test scripts/installer-budget.test.mjs",
    "verify:sqlite": "electron scripts/sqlite-smoke.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@trail/core": "*",
    "@trail/ipc": "*",
    "@trail/tokens": "*",
    "@electron/fuses": "^1.8.0",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}